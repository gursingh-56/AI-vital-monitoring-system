# Files kept in the repository but NOT uploaded to Vercel.
#
# The whole project lives in git; only the frontend is deployed. Vercel would
# ignore these anyway — it builds with `npm run build` from the root package.json
# and only treats `api/` as serverless functions — but excluding them explicitly
# keeps the deployment small and makes the intent obvious.
#
# Do NOT add `api/` here: that folder holds the Gemini function the frontend calls.

# Express backend — run locally or host separately
backend/

# Flask HuBERT-ECG service and the vendored upstream research repo
ECG/

# Standalone Bluetooth-mesh simulation
mesh_messenger/

# Source-stripping utility, only used before publishing
tools/
strip.config.json

# Local readable-source backup (also gitignored)
.source-backup/

# Secrets. These must NEVER be uploaded — configure them as Environment
# Variables in the Vercel project instead. Without this, `vercel` uploads .env
# as a build file and Vite reads it at build time, which both leaks the file
# into the deployment and hides the fact that the project env vars are unset.
.env
.env.*
